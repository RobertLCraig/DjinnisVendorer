			<Anchor point="CENTER"/>
		</Anchors>
		<Scripts>
			<OnShow>
				if self.SetBackdrop then
					self:SetBackdrop{
						bgFile = [[Interface\Tooltips\UI-Tooltip-Background]],
						edgeFile = [[Interface\AddOns\DjinnisVendorer\media\TooltipBorder]],
						edgeSize = 16,
						tile = true, tileSize = 16,
						insets = {left = 4, right = 4, top = 4, bottom = 4}
